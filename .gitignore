# Compiled binary (root level only)
/griffino

# Go binaries and plugins
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib
*.test
*.out

# Dependencies
vendor/

# Go workspace
go.work
go.work.sum

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build output (GoReleaser writes to the repo-root dist/)
/dist/
build/

# Embedded Web UI: fetched build artifacts are ignored, but the placeholder
# index.html is tracked so `go build` works before scripts/fetch-webui.sh runs.
/internal/api/web/dist/*
!/internal/api/web/dist/index.html

# Griffino local config (may contain credentials)
.griffino/

# Credentials / secrets
.env
.env.*
*.pem
*.key

# Logs
*.log
logs/
